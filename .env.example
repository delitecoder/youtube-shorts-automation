# Copy values into protected stores, NOT into a committed file:
#  - Claude cloud environment (pipeline): Environment variables / Network secrets
#  - Cloud Run (publisher): Secret Manager (--set-secrets) and plain env vars
# Safety flags (initial values — change only with explicit owner authorisation)
DRY_RUN=true
UPLOAD_ENABLED=false
PUBLICATION_ENABLED=false
PROMOTION_ENABLED=false

APPROVER_EMAIL=you@example.com
APPROVER_IS_OWNER=true
PUBLISH_TIMEZONE=Asia/Kolkata
PUBLISH_TIME=19:30
APPROVAL_TTL_HOURS=24
SPREADSHEET_ID=
DRIVE_FOLDER_IDS={"root":"","inbox":"","inbox_videos":"","inbox_documents":"","inbox_references":"","generated":"","awaiting_approval":"","published":"","rejected":"","archive":""}
YOUTUBE_CATEGORY_ID=27

TTS_PROVIDER=google
TTS_VOICE=en-US-Chirp3-HD-Charon
TTS_LANGUAGE=en-US
TTS_MONTHLY_CHAR_BUDGET=100000
TTS_FALLBACKS=kokoro,piper
KOKORO_VOICE=am_michael
ALLOW_EDGE_TTS=false
MUSIC_ENABLED=true
SFX_ENABLED=true
OUTRO_ENABLED=true
OUTRO_TEXT=If you learned something, subscribe for a new tech story every day.
VISION_CMD=

# Secrets (placeholders only — supply via secret stores)
YTA_PIPELINE_OAUTH=<authorized-user JSON for the pipeline profile>
YTA_PUBLISHER_OAUTH=<authorized-user JSON for the publisher profile — Cloud Run only>
GOOGLE_TTS_API_KEY=<only if not injected as a network secret>
WEBHOOK_SECRET=<64 random hex chars — Cloud Run + Apps Script only>
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=<app password — only when PROMOTION_ENABLED>
IMAGE_API_CONTACT=
# Images: open = CC0/PD/CC BY only; owner_approval = also other licences with a named creator,
# credited in the description and covered by the single video approval.
IMAGE_LICENSE_MODE=owner_approval
VISION_PROVIDERS=omnivision,smolvlm,google,clip,metadata
VLM_MODEL=HuggingFaceTB/SmolVLM-500M-Instruct
GOOGLE_VISION_ENABLED=false
VISION_MONTHLY_UNIT_BUDGET=800
ARCHIVE_FOLDER_ID=<Drive Archive folder id — Apps Script property>
